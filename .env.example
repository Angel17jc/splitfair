# =====================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el .env real al repositorio.
#   cp .env.example .env
# =====================================================

# ---- Base de datos ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_split
DB_USER=postgres
DB_PASSWORD=   # obligatorio, define una contrasena local

# ---- JWT ----
# Obligatorio. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
