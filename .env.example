# =====================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el .env real al repositorio.
#   cp .env.example .env
# =====================================================

# ---- Base de datos ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_split
DB_USER=postgres
DB_PASSWORD=   # obligatorio, define una contrasena local

# ---- JWT ----
# Obligatorio. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Cookie del refresh token ----
# El refresh token no viaja en el JSON: sale en una cookie HttpOnly que el
# navegador solo devuelve a /api/auth. Estos valores son los de desarrollo;
# el perfil prod ya fuerza Secure=true y SameSite=Strict.
#
# Secure=false hace falta en local porque el frontend habla por HTTP plano:
# una cookie Secure no se enviaria nunca y el refresco fallaria siempre.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
